@echo off
setlocal EnableExtensions DisableDelayedExpansion
title KOMODO CONTROL CENTER V17
set "KCC_MASTER=%~f0"
set "KOMODO_ROOT=H:\REPOSITORIOS GITHUB\komodo-main"
set "KCC_STATE=%KOMODO_ROOT%\.komodo-windows"
set "KCC_LOCALE=%KCC_STATE%\locale"
set "KCC_LANG_FILE=%KCC_STATE%\control-center.language"

if not exist "%KCC_STATE%\" mkdir "%KCC_STATE%" >nul 2>&1
if not exist "%KCC_LOCALE%\" mkdir "%KCC_LOCALE%" >nul 2>&1
if not exist "%KCC_LANG_FILE%" >"%KCC_LANG_FILE%" echo(EN

:KCC_RELOAD
@echo off
set "KCC_LANG=EN"
for /F "usebackq delims=" %%L in ("%KCC_LANG_FILE%") do set "KCC_LANG=%%L"
if /I "%KCC_LANG%"=="PT-BR" goto KCC_LANG_OK
if /I "%KCC_LANG%"=="ES" goto KCC_LANG_OK
if /I "%KCC_LANG%"=="DE" goto KCC_LANG_OK
if /I "%KCC_LANG%"=="JA" goto KCC_LANG_OK
if /I "%KCC_LANG%"=="FR" goto KCC_LANG_OK
set "KCC_LANG=EN"

:KCC_LANG_OK
call :KCC_EXTRACT_SELECTED
if errorlevel 1 goto KCC_RECOVERY

set "KCC_CHILD=%KCC_LOCALE%\control-center-%KCC_LANG%.bat"
call "%KCC_CHILD%"
set "KCC_RC=%ERRORLEVEL%"
if "%KCC_RC%"=="99" goto KCC_RELOAD
exit /b %KCC_RC%

:KCC_EXTRACT_SELECTED
@echo off
set "KCC_B64=%KCC_LOCALE%\selected.b64"
set "KCC_OUT=%KCC_LOCALE%\control-center-%KCC_LANG%.bat"
set "KCC_DECODER=%KCC_LOCALE%\decode-base64.vbs"
del /Q "%KCC_B64%" >nul 2>&1

if /I "%KCC_LANG%"=="EN" goto KCC_PAYLOAD_EN
if /I "%KCC_LANG%"=="PT-BR" goto KCC_PAYLOAD_PT
if /I "%KCC_LANG%"=="ES" goto KCC_PAYLOAD_ES
if /I "%KCC_LANG%"=="DE" goto KCC_PAYLOAD_DE
if /I "%KCC_LANG%"=="JA" goto KCC_PAYLOAD_JA
if /I "%KCC_LANG%"=="FR" goto KCC_PAYLOAD_FR
exit /b 1

:KCC_DECODE
@echo off
call :KCC_WRITE_DECODER
cscript.exe //nologo "%KCC_DECODER%" "%KCC_B64%" "%KCC_OUT%" >nul 2>&1
if not errorlevel 1 goto KCC_DECODE_OK
certutil.exe -f -decode "%KCC_B64%" "%KCC_OUT%" >nul 2>&1
if errorlevel 1 exit /b 1
:KCC_DECODE_OK
if not exist "%KCC_OUT%" exit /b 1
for %%Z in ("%KCC_OUT%") do if %%~zZ LSS 10000 exit /b 1
del /Q "%KCC_B64%" >nul 2>&1
exit /b 0

:KCC_WRITE_DECODER
@echo off
> "%KCC_DECODER%" echo Set a = WScript.Arguments
>>"%KCC_DECODER%" echo If a.Count ^< 2 Then WScript.Quit 2
>>"%KCC_DECODER%" echo Set fso = CreateObject("Scripting.FileSystemObject")
>>"%KCC_DECODER%" echo Set f = fso.OpenTextFile(a(0), 1, False)
>>"%KCC_DECODER%" echo s = f.ReadAll
>>"%KCC_DECODER%" echo f.Close
>>"%KCC_DECODER%" echo Set xml = CreateObject("Msxml2.DOMDocument.6.0")
>>"%KCC_DECODER%" echo Set n = xml.createElement("b64")
>>"%KCC_DECODER%" echo n.dataType = "bin.base64"
>>"%KCC_DECODER%" echo n.text = s
>>"%KCC_DECODER%" echo Set st = CreateObject("ADODB.Stream")
>>"%KCC_DECODER%" echo st.Type = 1
>>"%KCC_DECODER%" echo st.Open
>>"%KCC_DECODER%" echo st.Write n.nodeTypedValue
>>"%KCC_DECODER%" echo st.SaveToFile a(1), 2
>>"%KCC_DECODER%" echo st.Close
exit /b 0

:KCC_RECOVERY
@echo off
cls
echo ================================================================================================
echo   KOMODO CONTROL CENTER V17 - SAFE RECOVERY MODE
echo ================================================================================================
echo.
echo [ERROR] The selected language runtime could not be prepared.
echo [ERRO] O runtime do idioma selecionado nao pode ser preparado.
echo.
echo The window will stay open. / A janela permanecera aberta.
echo.
echo   [R] Retry / Tentar novamente
echo   [E] Force English
echo   [P] Forcar Portugues-BR
echo   [F] Open Control Center folder / Abrir pasta
echo   [0] Exit only if you choose / Sair somente se voce escolher
echo.
choice /C REPF0 /N /M "Choose / Escolha: "
if errorlevel 5 exit /b 1
if errorlevel 4 (
    start "" "%KCC_STATE%"
    goto KCC_RECOVERY
)
if errorlevel 3 (
    >"%KCC_LANG_FILE%" echo(PT-BR
    goto KCC_RELOAD
)
if errorlevel 2 (
    >"%KCC_LANG_FILE%" echo(EN
    goto KCC_RELOAD
)
goto KCC_RELOAD


